      "title": "基本の動詞 30",
      "description": "毎日の生活でよく使う動詞。例文といっしょに覚えましょう。",
      "words": [
        { "w": "go", "m": "行く", "ex": "I go to school by bus.", "exm": "私はバスで学校に行きます。" },
        { "w": "come", "m": "来る", "ex": "Please come to my house.", "exm": "私の家に来てください。" },
        { "w": "eat", "m": "食べる", "ex": "We eat lunch at noon.", "exm": "私たちは正午に昼食を食べます。" },
        { "w": "drink", "m": "飲む", "ex": "I drink milk every morning.", "exm": "私は毎朝牛乳を飲みます。" },
        { "w": "see", "m": "見る・見える", "ex": "I can see the sea from here.", "exm": "ここから海が見えます。" },
        { "w": "listen", "m": "聞く（耳を傾ける）", "ex": "Listen to the teacher.", "exm": "先生の話を聞きなさい。" },
        { "w": "speak", "m": "話す", "ex": "She can speak English well.", "exm": "彼女は英語を上手に話せます。" },
        { "w": "say", "m": "言う", "ex": "What did you say?", "exm": "何と言いましたか？" },
        { "w": "read", "m": "読む", "ex": "I read a book before bed.", "exm": "私は寝る前に本を読みます。" },
        { "w": "write", "m": "書く", "ex": "Write your name here.", "exm": "ここに名前を書いてください。" },
        { "w": "study", "m": "勉強する", "ex": "I study math after school.", "exm": "私は放課後に数学を勉強します。" },
        { "w": "learn", "m": "学ぶ・身につける", "ex": "We learn a lot from mistakes.", "exm": "私たちは失敗から多くを学びます。" },
        { "w": "know", "m": "知っている", "ex": "Do you know his name?", "exm": "彼の名前を知っていますか？" },
        { "w": "think", "m": "思う・考える", "ex": "I think it's a good idea.", "exm": "それはいい考えだと思います。" },
        { "w": "make", "m": "作る", "ex": "My father makes dinner on Sundays.", "exm": "父は日曜日に夕食を作ります。" },
        { "w": "take", "m": "取る・持っていく", "ex": "Take an umbrella with you.", "exm": "傘を持っていきなさい。" },
        { "w": "give", "m": "与える・あげる", "ex": "I gave her a present.", "exm": "私は彼女にプレゼントをあげました。" },
        { "w": "get", "m": "手に入れる・得る", "ex": "I got a letter from Ken.", "exm": "私はケンから手紙をもらいました。" },
        { "w": "buy", "m": "買う", "ex": "I want to buy a new bike.", "exm": "新しい自転車を買いたいです。" },
        { "w": "sell", "m": "売る", "ex": "That shop sells fruit.", "exm": "あの店は果物を売っています。" },
        { "w": "open", "m": "開ける", "ex": "Open the window, please.", "exm": "窓を開けてください。" },
        { "w": "close", "m": "閉める", "ex": "Close the door quietly.", "exm": "ドアを静かに閉めなさい。" },
        { "w": "start", "m": "始める・始まる", "ex": "The class starts at nine.", "exm": "授業は 9 時に始まります。" },
        { "w": "finish", "m": "終える", "ex": "Did you finish your homework?", "exm": "宿題は終わりましたか？" },
        { "w": "help", "m": "手伝う・助ける", "ex": "Can you help me?", "exm": "手伝ってくれますか？" },
        { "w": "use", "m": "使う", "ex": "May I use your pen?", "exm": "あなたのペンを使ってもいいですか？" },
        { "w": "run", "m": "走る", "ex": "He runs in the park every day.", "exm": "彼は毎日公園で走ります。" },
        { "w": "walk", "m": "歩く", "ex": "Let's walk to the station.", "exm": "駅まで歩きましょう。" },
        { "w": "sleep", "m": "眠る", "ex": "I sleep for eight hours.", "exm": "私は 8 時間眠ります。" },
        { "w": "live", "m": "住む", "ex": "My aunt lives in Osaka.", "exm": "おばは大阪に住んでいます。" }
