#include <winres.h>
#include "resource.h"

// タイルの画像（account/icon-192.png を白地の 24 ビット BMP にしたもの）
IDB_TILE_IMAGE BITMAP "..\\..\\res\\tile.bmp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName", "SK"
      VALUE "FileDescription", "SK Hub Credential Provider"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductName", "SK Hub Windows Logon"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
