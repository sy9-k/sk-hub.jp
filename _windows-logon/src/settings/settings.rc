#include <winres.h>
#include "resource.h"

// アプリのアイコン（account/icon-192.png から作った res/app.ico）
IDI_APP ICON "..\\..\\res\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName", "SK"
      VALUE "FileDescription", "SK Hub Windows Logon Settings"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductName", "SK Hub Windows Logon"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
