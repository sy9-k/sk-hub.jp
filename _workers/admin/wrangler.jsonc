// SK の管理画面（admin.sk-hub.jp）の Worker。手順は README.md
{
  "name": "sk-admin",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // 公開するアドレス（ゾーン sk-hub.jp が同じ Cloudflare アカウントにあること。DNS は deploy で自動で作られる）
  "routes": [
    { "pattern": "admin.sk-hub.jp", "custom_domain": true }
  ],
  "workers_dev": false,
  // 招待のメール（src/invite-mail.js）。Resend の API キーはシークレット RESEND_API_KEY（npx wrangler secret put RESEND_API_KEY）
  "vars": {
    "MAIL_FROM": "SK Hub Systems <noreply@sk-hub.jp>"
  },
  "observability": { "enabled": true }
}
